{
    "name": "happy-desktop-electron",
    "version": "0.0.76",
    "private": true,
    "description": "Happy Place macOS desktop app",
    "author": "Slopus",
    "files": [
        "dist",
        "assets/app-icon/generated/app-icon.png"
    ],
    "type": "module",
    "main": "dist/main.js",
    "exports": {
        "./renderer": "./sources/renderer/renderer.tsx",
        "./vite": "./vite.config.ts"
    },
    "scripts": {
        "dev": "VITE_HAPPY_BROWSER_LOCAL=1 vite --host 127.0.0.1 --port ${PORT:-5174} --strictPort",
        "predev:electron": "node ../../scripts/name-dev-electron.mjs",
        "dev:electron": "PORT=${PORT:-5174}; concurrently --kill-others-on-fail --names main,preload,renderer,electron \"vite build --config vite.main.config.ts --watch\" \"vite build --config vite.preload.config.ts --watch\" \"vite --host 127.0.0.1 --port $PORT --strictPort\" \"wait-on dist/main.js dist/preload.cjs tcp:$PORT && VITE_DEV_SERVER_URL=http://127.0.0.1:$PORT electron ./dist/main.js\"",
        "dev:electron:profile": "export HAPPY_DESKTOP_PROFILE=1 HAPPY_DESKTOP_PROFILE_MODE=development; pnpm run dev:electron",
        "build": "vite build && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
        "build:profile": "HAPPY_DESKTOP_PROFILE=1 vite build && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
        "build:profile:optimized": "HAPPY_DESKTOP_PROFILE=1 HAPPY_DESKTOP_PROFILE_MODE=optimized pnpm run build:profile",
        "prebuild:local-shell": "rm -rf dist",
        "build:local-shell": "HAPPY_DESKTOP_FLAVOR=local-web HAPPY_LOCAL_WEB_ORIGIN=https://local.app.happy.engineering vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
        "build:local-web-ui": "HAPPY_LOCAL_WEB_SITE=1 vite build --outDir release/local-web-site",
        "predist:mac": "pnpm --dir ../.. desktop:assets",
        "dist:mac": "pnpm build && electron-builder --mac",
        "dist:linux": "pnpm build && electron-builder --linux --publish never",
        "dist:win": "pnpm build && electron-builder --win --publish never",
        "prerelease:mac": "pnpm --dir ../.. desktop:assets",
        "release:mac": "pnpm build && electron-builder --mac --arm64 --x64",
        "prestart": "node ../../scripts/name-dev-electron.mjs",
        "start": "electron ./dist/main.js",
        "start:profile": "pnpm run start:profile:optimized",
        "start:profile:optimized": "HAPPY_DESKTOP_PROFILE=1 HAPPY_DESKTOP_PROFILE_MODE=optimized electron ./dist/main.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --project tsconfig.json",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "node ../../scripts/check-react-boundaries.mjs && oxlint .",
        "clean": "rm -rf dist release"
    },
    "dependencies": {
        "@slopus/happy-agent-client": "0.0.54",
        "electron-updater": "^6.8.9",
        "ws": "^8.21.1",
        "yjs": "^13.6.31"
    },
    "devDependencies": {
        "@slopus/ghostty-web": "0.1.0",
        "@tailwindcss/vite": "^4.3.2",
        "@tanstack/react-router": "^1.170.18",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.1",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "^6.0.3",
        "concurrently": "^10.0.3",
        "electron": "^43.1.0",
        "electron-builder": "^26.15.3",
        "happy-desktop-app": "workspace:*",
        "happy-desktop-state": "workspace:*",
        "happy-desktop-ui": "workspace:*",
        "jsdom": "^29.1.1",
        "react": "19.2.7",
        "react-devtools-core": "6.1.5",
        "react-dom": "19.2.7",
        "tailwindcss": "^4.3.2",
        "typescript": "^7.0.2",
        "vite": "^8.1.4",
        "vitest": "^4.1.10",
        "wait-on": "^9.0.10"
    },
    "packageManager": "pnpm@10.28.1",
    "build": {
        "appId": "com.slopus.happy",
        "productName": "Happy",
        "asar": true,
        "npmRebuild": false,
        "asarUnpack": [
            "node_modules/**/*"
        ],
        "directories": {
            "buildResources": "build",
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "protocols": [
            {
                "name": "Happy Auth",
                "schemes": [
                    "happy-auth"
                ]
            }
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "hardenedRuntime": true,
            "icon": "assets/app-icon/generated/app-icon.icns",
            "notarize": true,
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ]
        },
        "dmg": {
            "sign": false
        },
        "linux": {
            "category": "Development",
            "icon": "assets/app-icon/generated/app-icon.png",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "artifactName": "Happy-${version}-${arch}.${ext}",
        "publish": {
            "provider": "github",
            "owner": "slopus",
            "repo": "happy-desktop",
            "releaseType": "release"
        }
    }
}
